rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reads and writes to site_data collection for website content management
    match /site_data/{document=**} {
      allow read, write: if true;
    }

    // Allow general fallback access for application documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
